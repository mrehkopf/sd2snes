; This file is part of the snescom-asm demo - a demo of how to build a SNES program.
; See http://bisqwit.iki.fi/source/snescom.html for details.

; Begin assembling to this address.
*= $C0F800

RESET:
        sei
        clc
        xce
        rep #$20 : .al
        lda #$1fff
        tcs
        lda #$55
        sta @$00ff33
        lda #$77
        sta @$00ff34  ; leave linear memory mode
        jmp @GAME_MAIN

NMI_16bit:
        php
         rep #$30 : .al : .xl
         pha: phx: phy: phd: phb
         jsl @NMI_ROUTINE
         rep #$30 : .al : .xl
int_exit:
         plb: pld: ply: plx: pla
        plp
        rti

IRQ_16bit:
ABT_8bit: ABT_16bit:
        php
         rep #$30 : .al : .xl
         pha: phx: phy: phd: phb
         jsl @IRQ_ROUTINE
	 rep #$30 : .al : .xl
         bra int_exit

;error vectors
BRK_8bit: BRK_16bit:
COP_8bit: COP_16bit:
IRQ_8bit:
NMI_8bit:
        - wai: lda $ABCDEF : bra -


