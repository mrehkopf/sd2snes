.link page $c0
GAME_MAIN:
	sep #$20 : .as
	stz $4200 ; inhibit VBlank NMI
	lda #$01
	sta $420d ; fast cpu
	jsr waitblank
	lda #$00
	sta @$00ff00
	sta @$00ff01
	sta @$00ff02
	sta @$00ff03
	lda #$00
	sta @$00ff1f
	sta $20 ; loop count
	jsr snes_init
	jsr video_init
	jsr linetest
-	dec $20
	jsr batest
	jsr snes_init
	jsr video_init
;	jsr copy_memtest
	jsr copy_memconn
	jsr irqtest
	jsl $7e1800
	lda $20
	bne -
	lda $10
	sta @$00ff00
	lda $12
	sta @$00ff02
	lda $11
	sta @$00ff01
-	bra -

; copy_memtest:
; 	rep #$30 : .al : .xl
; 	lda #$0300
; 	ldx #!memtest
; 	ldy #$1800
; 	mvn $7e, ^memtest
; 	rts

copy_memconn:
	rep #$30 : .al : .xl
	lda #$0300
	ldx #!memconn
	ldy #$1800
	mvn $7e, ^memconn
	rts

linetest
	sep #$20 : .as
	lda #$00
	pha
	plb
-	lda $0000
	lda $2100
	sta $21ff
	lda @$ff1f
	cmp #$01
	bne -
	rts

irqtest:
	cli
	sep #$20 : .as
	rep #$10 : .xl
	lda #$0f
	sta $2100
	lda #$ff
	sta $4209
	lda #$ff
	sta $420a
	lda #$ff
	sta $4200
	sta $10
	lda #$01
	sta @$00ff22
	rts

batest:
	sei
	sep #$20 : .as
	rep #$10 : .xl
	lda #$00
	pha
	plb
	ldx #$2100
-	sta !$0, x
	inx
	inc
	bne -
	lda #$00
	pha
	plb
	lda #$00
	ldx #$fe00
-	cmp !$0, x
	bne batest_fail
	inx
	inc
	bne -
	lda #$5a
	sta $12
	rts
batest_fail:
	lda #$ff
	sta $12
	stz $20 ; stop after this test iteration
	rts


