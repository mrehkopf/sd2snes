memconn:
; test line connections as thorough as possible
; indirect long address at $00-$02
; error flag at $03
; log index at $04-$06
; done/result flag at $00:ff01
; error log from $00:ff04
	sei
	sep #$20 : .as
	rep #$10 : .xl

	lda #$55
	sta @$00ff33
	lda #$aa
	sta @$00ff34     ; switch to linear memory mode

	lda #$00
	sta @$008400
	sta @$008800
	sta @$009000
	sta @$00a000
	sta @$00c000
	sta @$008000
	sta @$018000
	sta @$028000
	sta @$048000
	sta @$088000
	sta @$108000
	sta @$208000
	sta @$400000
	sta @$408000
	sta @$808000

	ldy #$0000
	ldx #$ff04
	stx $04
	ldx #$0400       ; start address: $00:0400 (changed into $00:8400)
	stx $00
	lda #$00
	sta $02
	sta $06
	lda #$5a         ; default result: OK
	sta $03
memconn_loop:
	lda $02          ; check for $00:8000 itself
	bne +
	ldx $00
	cpx #$8000
	beq memconn_skip ; skip $8000 which is our baseline

+	lda $01
	ora #$80
	sta $01          ; set A15 always
	lda #$00
	sta @$008000
	lda #$ff
	sta [$00]
	lda @$008000
	cmp #$00
	bne memconn_error
	lda [$00]
	cmp #$ff
	bne memconn_error
memconn_cont:
	iny
	lda $01
	and #$7f         ; clear A15 for shift
	sta $01
memconn_skip:
	clc
	rol $00          ; shift 24-bit address left by one bit
	rol $01
	rol $02
	bcc memconn_loop ; as long as no bank overflow occurs, loop
	lda #$55
	sta @$00ff33
	lda #$77
	sta @$00ff34     ; exit linear memory mode

	lda $03
	cmp #$5a
	bne +

	lda #$00
	sta @$002121
	lda #$e0
	sta @$002122
	lda #$03
	sta @$002122

+	lda #$ff
	sta [$04]
	lda $03
	sta $11
	rtl

memconn_error:
	lda #$55
	sta @$00ff33
	lda #$77
	sta @$00ff34     ; exit linear memory mode
	tya
	sta [$04]
	lda #$ff         ; overall result: FAIL
	sta $03
	stz $20          ; do not run again
	ldx $04
	inx
	stx $04
	lda #$55
	sta @$00ff33
	lda #$aa
	sta @$00ff34     ; back to linear memory mode
	bra memconn_cont

